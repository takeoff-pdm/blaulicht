<?xml version="1.0" encoding="UTF-8"?>
<!-- blenv window manager config. Without a WM, egui external-screen viewports are
     recreated every frame; openbox (also used on the kiosk) keeps them stable.
     No decorations anywhere (the kiosk strips them with devilspie2), so window
     geometry equals the client area that screenshots and clicks use. No key or
     mouse bindings, so injected input only reaches the app. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
  </placement>
  <desktops>
    <number>1</number>
  </desktops>
  <margins><top>0</top><bottom>0</bottom><left>0</left><right>0</right></margins>
  <keyboard></keyboard>
  <mouse></mouse>
  <applications>
    <application class="*">
      <decor>no</decor>
    </application>
  </applications>
</openbox_config>
